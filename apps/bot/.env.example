# Copy to repo-root `.env` or `apps/bot/.env` (gitignored). Never commit real secrets.

DISCORD_TOKEN=
DEEPGRAM_API_KEY=
# Local Docker Postgres (infra/docker-compose.yml):
DATABASE_URL=postgresql://app:app@localhost:5432/app
# Optional:
FFMPEG_EXECUTABLE=ffmpeg
OPENAI_API_KEY=
# Public help site (GitHub Pages); used by /help
HELP_URL=https://csen-scu.github.io/csen-174-s26-team-project-ttstt/
# Debug: save each STT utterance as WAV under stt_debug_audio/ (play with ffplay, vlc, etc.)
STT_DEBUG_SAVE_WAV=1
# STT_DEBUG_WAV_DIR=stt_debug_audio
