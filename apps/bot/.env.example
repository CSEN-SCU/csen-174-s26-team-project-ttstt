# TTSTT bot - copy to `.env` at the repo root and fill in real values.
# `.env` is gitignored; never commit real tokens or API keys.
# If a secret was ever pushed, rotate it immediately at the provider's portal.

# --- Discord ---
# Bot token from https://discord.com/developers/applications -> your app -> Bot.
DISCORD_TOKEN=
# Optional: a test server ID so slash commands sync immediately during dev.
# Leave blank for global sync (can take up to an hour to propagate).
DISCORD_GUILD_ID=

# --- ElevenLabs TTS ---
# API key from https://elevenlabs.io -> Profile -> API Keys.
ELEVENLABS_API_KEY=
# Voice ID from https://elevenlabs.io -> Voices -> click a voice -> "ID".
ELEVENLABS_VOICE_ID=
# Optional model override; defaults to eleven_turbo_v2_5 (low latency, multilingual).
# See https://elevenlabs.io/docs/models for alternatives.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Optional voice-settings tuning. Leave blank to use ElevenLabs defaults.
# Each value is a float between 0.0 and 1.0.
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY_BOOST=
ELEVENLABS_STYLE=
# Optional boolean (true/false). Whether to enhance the speaker similarity.
ELEVENLABS_USE_SPEAKER_BOOST=

# --- TTS limits ---
# Maximum characters accepted from /say or a relayed message before truncation.
TTS_MAX_CHARS_PER_MESSAGE=500
# Internal soft-chunk size before each ElevenLabs request; smaller = faster first audio.
TTS_MAX_CHARS_PER_CHUNK=240

# --- Audio ---
# Path to the ffmpeg binary. Leave as `ffmpeg` if it is on PATH.
FFMPEG_EXECUTABLE=ffmpeg
